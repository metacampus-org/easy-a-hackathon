# ================================
# MetaCAMPUS Environment Variables
# ================================
# Copy this file to .env.local and fill in your values
# Command: cp .env.example .env.local

# ================================
# ALGORAND BLOCKCHAIN CONFIGURATION
# ================================

# Algorand Node API URL
# For Testnet: Use public node like https://testnet-api.4160.nodely.dev
# For Mainnet: Use https://mainnet-api.4160.nodely.dev
# For Local: Use http://localhost:4001
NEXT_PUBLIC_ALGOD_URL=https://testnet-api.4160.nodely.dev

# Algorand Indexer URL
# For Testnet: Use public indexer like https://testnet-idx.4160.nodely.dev
# For Mainnet: Use https://mainnet-idx.4160.nodely.dev
# For Local: Use http://localhost:8980
NEXT_PUBLIC_INDEXER_URL=https://testnet-idx.4160.nodely.dev

# Algorand Node Token (optional for public nodes)
# Leave empty for public nodes, add token for private/local nodes
NEXT_PUBLIC_ALGOD_TOKEN=

# Algorand Indexer Token (optional for public nodes)
NEXT_PUBLIC_INDEXER_TOKEN=

# Algorand Network
# Options: testnet, mainnet, localhost
NEXT_PUBLIC_ALGORAND_NETWORK=testnet

# ================================
# SMART CONTRACT CONFIGURATION
# ================================

# Authentication Contract App ID
# Set to 0 before deployment, update after deploying auth contract
# Example for testnet: 748159417
NEXT_PUBLIC_APP_ID=0

# Badge Management Contract App ID (legacy/optional)
# Example for testnet: 733353489
NEXT_PUBLIC_ALGORAND_APP_ID=0

# Badge Contract App ID (if separate from NEXT_PUBLIC_APP_ID)
NEXT_PUBLIC_BADGE_APP_ID=0

# ================================
# SUPER ADMIN CONFIGURATION
# ================================

# Super Admin Wallet Address
# This is the Algorand wallet address with super admin privileges
# Must be a valid 58-character Algorand address
# Example: ABCDEFGHIJKLMNOPQRSTUVWXYZ234567ABCDEFGHIJKLMNOPQRSTUVWXY
NEXT_PUBLIC_SUPER_ADMIN_WALLET=YOUR_WALLET_ADDRESS_HERE

# ================================
# DATABASE CONFIGURATION (PostgreSQL)
# ================================

# PostgreSQL Database Host
# For local development: localhost
# For production: Your database server IP/hostname
DB_HOST=localhost

# PostgreSQL Database Port
# Default PostgreSQL port is 5432
DB_PORT=5432

# PostgreSQL Database User
# Change this to your PostgreSQL username
DB_USER=postgres

# PostgreSQL Database Password
# Change this to your PostgreSQL password
# IMPORTANT: Use a strong password in production
DB_PASSWORD=password

# PostgreSQL Database Name
DB_NAME=metacampus_db

# ================================
# SQLITE CONFIGURATION (Optional)
# ================================

# SQLite Database Path (for local development/testing)
# Used as fallback or for development
SQLITE_DB_PATH=./data/metacampus.db

# ================================
# LEGACY WEB3AUTH (Optional - for backward compatibility)
# ================================

# Web3Auth Client ID
# Get from: https://dashboard.web3auth.io/
# Leave empty if not using Web3Auth
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=

# Web3Auth Network
# Options: testnet, mainnet, cyan
NEXT_PUBLIC_WEB3AUTH_NETWORK=testnet

# ================================
# FEATURE FLAGS
# ================================

# Enable University Signup Feature
# Set to 'true' to allow universities to self-register
NEXT_PUBLIC_ENABLE_UNIVERSITY_SIGNUP=true

# Enable IPFS Integration
# Set to 'true' to enable IPFS for document storage
NEXT_PUBLIC_ENABLE_IPFS=false

# ================================
# DEBUG & DEVELOPMENT
# ================================

# Enable Authentication Debug Logging
# Set to 'true' to see detailed auth logs in console
NEXT_PUBLIC_DEBUG_AUTH=false

# Node Environment
# Options: development, production, test
NODE_ENV=development

# ================================
# STORAGE CONFIGURATION (Optional)
# ================================

# IPFS Gateway URL (if IPFS is enabled)
# NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/

# IPFS API URL (if IPFS is enabled)
# NEXT_PUBLIC_IPFS_API=https://api.pinata.cloud

# IPFS API Key (if using Pinata or similar service)
# IPFS_API_KEY=

# ================================
# NOTES:
# ================================
# 1. Never commit .env.local to version control
# 2. All NEXT_PUBLIC_* variables are exposed to the browser
# 3. Variables without NEXT_PUBLIC_ prefix are server-side only
# 4. Update APP_ID values after deploying smart contracts
# 5. See docs/EC2_ALGORAND_NODE_SETUP.md for node setup
# 6. See docs/BADGE_CONTRACT_DEPLOYMENT.md for contract deployment
